# ==============================================================================
# VaidyaMD HMS Backend — Production Environment Template
# ==============================================================================
ENVIRONMENT=production
DEBUG=false
APP_VERSION=1.0.0

# Database Credentials
POSTGRES_DB=vaidya_md_db
POSTGRES_USER=vaidya_md_admin
POSTGRES_PASSWORD=generate_a_strong_database_password_here_min_32_chars
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@vaidya_md_db:5432/${POSTGRES_DB}

# Cryptography & JWT Security
JWT_SECRET_KEY=generate_a_cryptographically_secure_jwt_secret_key_minimum_48_chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480
# Dedicated Fernet PII Encryption Key (Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
PII_ENCRYPTION_KEY=generate_a_dedicated_32_byte_base64_fernet_key_here

# Storage
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=50

# Database Controls
SEED_DB=false
FORCE_DROP_DB=false

# CORS Allowed Origins
CORS_ORIGINS=https://md.vaidyahealth.com,https://dev.md.vaidyahealth.com
