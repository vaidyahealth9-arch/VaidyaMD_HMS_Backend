# ==============================================================================
# VaidyaMD HMS Backend — Environment Variables Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your local/staging configuration.

ENVIRONMENT=development
DEBUG=true
APP_VERSION=1.0.0

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=vaidya_md_db
POSTGRES_USER=vaidya_md_admin
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql+asyncpg://vaidya_md_admin:your_secure_password_here@localhost:5432/vaidya_md_db

# Cryptography & JWT Security
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480
# PII Field Encryption (Fernet 32-byte base64 key or passphrase)
PII_ENCRYPTION_KEY=change_this_to_a_dedicated_32_byte_base64_fernet_key

# Storage & Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Database Seeding Controls
SEED_DB=false
SEED_MODE=base
FORCE_DROP_DB=false

# CORS Configuration (JSON array or comma-separated list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
